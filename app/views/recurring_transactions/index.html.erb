<header class="flex items-center justify-between">
  <h1 class="text-primary text-xl font-medium">Recurring Transactions</h1>
  <%= render DS::Link.new(
    text: "New Recurring Transaction",
    variant: "primary",
    icon: "plus",
    href: new_recurring_transaction_path
  ) %>
</header>

<div class="bg-container rounded-xl shadow-border-xs p-4">
  <% if @recurring_transactions.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-primary">
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary uppercase tracking-wider">Name</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary uppercase tracking-wider">Account</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary uppercase tracking-wider">Amount</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary uppercase tracking-wider">Schedule</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary uppercase tracking-wider">Next Run</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-secondary uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-primary">
          <% @recurring_transactions.each do |rt| %>
            <tr class="hover:bg-container-inset">
              <td class="px-4 py-3 text-sm text-primary">
                <div class="font-medium"><%= rt.name %></div>
                <% if rt.notes.present? %>
                  <div class="text-xs text-secondary"><%= rt.notes %></div>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-primary">
                <%= rt.account&.name %>
                <% if rt.transfer? && rt.counter_account %>
                  <div class="text-xs text-secondary">→ <%= rt.counter_account.name %></div>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-primary">
                <%= format_money(Money.new(rt.amount, rt.currency)) %>
              </td>
              <td class="px-4 py-3 text-sm text-primary">
                Day <%= rt.day_of_month %>, every <%= rt.interval_months %> <%= rt.interval_months == 1 ? 'month' : 'months' %>
              </td>
              <td class="px-4 py-3 text-sm text-primary">
                <%= format_date(rt.next_run_on) if rt.next_run_on %>
              </td>
              <td class="px-4 py-3 text-sm">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= 
                  case rt.status
                  when 'active' then 'bg-green-100 text-green-800'
                  when 'paused' then 'bg-yellow-100 text-yellow-800'
                  when 'archived' then 'bg-gray-100 text-gray-800'
                  end
                %>">
                  <%= rt.status.humanize %>
                </span>
              </td>
              <td class="px-4 py-3 text-sm">
                <div class="flex items-center gap-1">
                  <%= render DS::Link.new(
                    variant: "icon",
                    icon: "pencil",
                    size: "sm",
                    href: edit_recurring_transaction_path(rt),
                    title: "Edit"
                  ) %>
                  
                  <% if rt.active? %>
                    <%= button_to pause_recurring_transaction_path(rt), method: :post, class: "inline-flex" do %>
                      <%= icon("pause", size: "sm", class: "text-yellow-600 hover:text-yellow-800") %>
                    <% end %>
                  <% elsif rt.paused? %>
                    <%= button_to resume_recurring_transaction_path(rt), method: :post, class: "inline-flex" do %>
                      <%= icon("play", size: "sm", class: "text-green-600 hover:text-green-800") %>
                    <% end %>
                  <% end %>
                  
                  <%= button_to recurring_transaction_path(rt), 
                      method: :delete, 
                      data: { confirm: "Are you sure you want to delete this recurring transaction?" },
                      class: "inline-flex" do %>
                    <%= icon("trash-2", size: "sm", color: "destructive") %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="flex justify-center items-center py-20">
      <div class="text-center flex flex-col items-center max-w-[500px]">
        <p class="text-sm text-primary font-medium mb-1">No recurring transactions yet</p>
        <p class="text-sm text-secondary mb-4">Set up recurring transactions to automatically create transactions on a schedule.</p>
        <%= render DS::Link.new(
          text: "New Recurring Transaction",
          variant: "primary",
          icon: "plus",
          href: new_recurring_transaction_path
        ) %>
      </div>
    </div>
  <% end %>
</div>