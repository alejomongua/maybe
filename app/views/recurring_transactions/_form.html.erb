<%# locals: (recurring_transaction:) %>

<%= styled_form_with model: recurring_transaction, class: "space-y-6" do |f| %>

  <% if recurring_transaction.errors.any? %>
    <%= render "shared/form_errors", model: recurring_transaction %>
  <% end %>

  <section class="space-y-4">
    <h3 class="text-sm font-medium text-primary">Basic Information</h3>
    
    <%= f.text_field :name, label: "Name", required: true, placeholder: "e.g., Monthly Rent, Netflix Subscription" %>
    
    <%= f.text_area :notes, label: "Notes", placeholder: "Optional description" %>
  </section>

  <section class="space-y-4">
    <h3 class="text-sm font-medium text-primary">Transaction Details</h3>
    
    <%= f.select :kind, 
        options_for_select([["Standard Transaction", "standard"], ["Transfer", "transfer"]], recurring_transaction.kind),
        { label: "Type", required: true, include_blank: "Select type" } %>
    
    <%= f.collection_select :account_id, 
        Current.family.accounts, :id, :name,
        { label: "Account", required: true, include_blank: "Select an account" } %>
    
    <%= f.collection_select :counter_account_id, 
        Current.family.accounts, :id, :name,
        { label: "Counter Account", include_blank: "Select counter account (required for transfers)" },
        { data: { recurring_transactions_target: "counterAccountField" } } %>
    
    <%= f.number_field :amount, 
        label: "Amount", 
        required: true,
        step: 0.01,
        placeholder: "0.00" %>
    
    <%= f.text_field :currency, 
        label: "Currency",
        required: true,
        value: recurring_transaction.currency.presence || Current.family.currency,
        placeholder: "USD" %>
    
    <%= f.collection_select :category_id, 
        Current.family.categories, :id, :name,
        { label: "Category", include_blank: "Select a category (optional)" } %>
    
    <%= f.collection_select :merchant_id, 
        Current.family.merchants, :id, :name,
        { label: "Merchant", include_blank: "Select a merchant (optional)" } %>
  </section>

  <section class="space-y-4">
    <h3 class="text-sm font-medium text-primary">Schedule</h3>
    
    <%= f.number_field :day_of_month, 
        label: "Day of Month",
        required: true,
        min: 1,
        max: 31,
        placeholder: "1-31" %>
    
    <%= f.number_field :interval_months, 
        label: "Repeat Every (Months)",
        required: true,
        min: 1,
        value: recurring_transaction.interval_months || 1,
        placeholder: "1 = monthly, 3 = quarterly, 12 = yearly" %>
    
    <%= f.select :weekend_strategy,
        options_for_select([
          ["No Adjustment", "no_adjustment"],
          ["Following Business Day", "following"],
          ["Preceding Business Day", "preceding"],
          ["Nearest Business Day", "nearest"],
          ["Last Day of Month", "last_day"]
        ], recurring_transaction.weekend_strategy),
        { label: "Weekend Strategy", required: true, include_blank: "Select strategy" } %>
    
    <%= f.date_field :start_on, 
        label: "Start Date",
        required: true,
        value: recurring_transaction.start_on || Date.current %>
    
    <%= f.date_field :end_on, 
        label: "End Date (Optional)",
        placeholder: "Leave blank for indefinite" %>
    
    <%= f.time_zone_select :timezone,
        ActiveSupport::TimeZone.all,
        { label: "Timezone", required: true, default: recurring_transaction.timezone.presence || Current.family.timezone } %>
  </section>

  <section class="space-y-4">
    <h3 class="text-sm font-medium text-primary">Status</h3>
    
    <%= f.select :status,
        options_for_select([
          ["Active", "active"],
          ["Paused", "paused"],
          ["Archived", "archived"]
        ], recurring_transaction.status || "active"),
        { label: "Status", required: true } %>
  </section>

  <%= f.submit recurring_transaction.new_record? ? "Create Recurring Transaction" : "Update Recurring Transaction" %>
<% end %>